# Server
PORT=5000
NODE_ENV=development

# MongoDB (local example — replace with your Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/kindhands

# Auth
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — the frontend origin allowed to call this API
CLIENT_URL=http://localhost:5175
