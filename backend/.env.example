# Server
PORT=5000
NODE_ENV=development

# MongoDB — if using the docker-compose.yml in the project root, this is
# mongodb://127.0.0.1:27018/kindhands (port 27018, not the default 27017,
# to avoid clashing with a local MongoDB install). Change the db name at
# the end of the URI to target a different database within the same
# container/cluster — Mongo creates it automatically on first write.
MONGO_URI=mongodb://127.0.0.1:27018/kindhands

# Auth
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — the frontend origin allowed to call this API
CLIENT_URL=http://localhost:5175
